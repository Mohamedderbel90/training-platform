# Local development configuration for the Next.js operational frontend.
# Copy to frontend/.env.local (gitignored) and adjust as needed.
# No secrets belong in this file.

# Server-only (never sent to the browser -- no NEXT_PUBLIC_ prefix).
# Where the Next.js server itself can reach the real Odoo instance, to
# proxy /api/v1/* requests there (see next.config.ts's rewrites() and
# docs/adr/ADR-006-nextjs-operational-ui.md). The BROWSER never talks
# to this URL directly -- it only ever calls the Next.js origin's own
# /api/v1/* path, same-origin, so the Odoo session_id cookie is
# preserved without CORS or a custom token scheme (see ADR-005).
ODOO_INTERNAL_BASE_URL=http://localhost:8069

# Default locale; must stay in sync with PROJECT_SPEC section 2A
# (Arabic is the default product language unless overridden here).
NEXT_PUBLIC_DEFAULT_LOCALE=ar
