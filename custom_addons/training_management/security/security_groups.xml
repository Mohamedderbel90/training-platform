<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- VERIFIED RUNTIME NOTE (milestone M1): res.groups no longer has
         a "category_id" field on Odoo 19 (it was replaced by
         res.groups.privilege, a heavier "access level" grouping
         concept with different, mutually-exclusive-selection
         semantics that do not fit these five independent roles). No
         category/privilege grouping is used here; it is a UI
         organization nicety, not a security requirement. -->

    <record id="group_training_trainee" model="res.groups">
        <field name="name">Trainee</field>
    </record>

    <record id="group_training_supervisor" model="res.groups">
        <field name="name">Supervisor</field>
    </record>

    <record id="group_training_trainer" model="res.groups">
        <field name="name">Trainer</field>
    </record>

    <!-- Assistant Admin: delegated operational administration only.
         Does not, by default, approve final reports (PROJECT_SPEC
         section 7.2). Approval logic itself is out of scope for M1. -->
    <record id="group_training_assistant_admin" model="res.groups">
        <field name="name">Assistant Admin</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- General Supervisor / Admin: full administrative access,
         including full standard Survey administration (Survey
         templates/questions/versioning per PROJECT_SPEC section 7.1) via
         the standard survey.group_survey_manager group. Trainee/
         Supervisor/Trainer deliberately do NOT get group_survey_user
         (see ir.model.access.csv/security_rules.xml): that standard
         group's own record rules grant unrestricted access to every
         survey in the database, which would break the response-privacy
         isolation this project requires. -->
    <record id="group_training_admin" model="res.groups">
        <field name="name">General Supervisor / Admin</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('survey.group_survey_manager'))]"/>
    </record>
</odoo>
