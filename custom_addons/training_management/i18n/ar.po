#. module: training_management
#. odoo-python
#: code:addons/training_management/models/survey_survey.py:0
msgid ""
"\"%s\" already has submitted responses and cannot be deleted. Archive it "
"instead."
msgstr ""
"\"%s\" لديها ردود مُرسلة بالفعل ولا يمكن حذفها. يرجى أرشفتها بدلاً من ذلك."

#. module: training_management
#. odoo-python
#: code:addons/training_management/models/survey_question_answer.py:0
msgid ""
"\"%s\" already has submitted responses; its answer options cannot be "
"changed. Clone the survey as a new version instead."
msgstr ""
"\"%s\" لديه ردود مُرسلة؛ لا يمكن تغيير خيارات الإجابة فيه. انسخيه كنسخة "
"جديدة بدلاً من ذلك."

#. module: training_management
#. odoo-python
#: code:addons/training_management/models/survey_survey.py:0
msgid ""
"\"%s\" already has submitted responses; its structure/ownership cannot be "
"changed. Clone it as a new version instead."
msgstr ""
"\"%s\" لديها ردود مُرسلة بالفعل؛ لا يمكن تغيير بنيتها أو ملكيتها. يرجى "
"استنساخها كنسخة جديدة بدلاً من ذلك."

#. module: training_management
#. odoo-python
#: code:addons/training_management/models/survey_question.py:0
msgid ""
"\"%s\" belongs to a survey that already has submitted responses and cannot "
"be deleted."
msgstr "\"%s\" تابعة لاستبانة لديها ردود مُرسلة بالفعل ولا يمكن حذفها."

#. module: training_management
#. odoo-python
#: code:addons/training_management/models/survey_question.py:0
msgid ""
"\"%s\" belongs to a survey that already has submitted responses; its KPI "
"category/question type cannot be changed. Clone the survey as a new version "
"instead."
msgstr ""
"\"%s\" تابعة لاستبانة لديها ردود مُرسلة بالفعل؛ لا يمكن تغيير فئة المؤشر أو "
"نوع السؤال. يرجى استنساخ الاستبانة كنسخة جديدة بدلاً من ذلك."

#. module: training_management
#. odoo-python
#: code:addons/training_management/models/training_report.py:0
msgid "%(base)s Report (v%(version)s)"
msgstr "تقرير %(base)s (الإصدار %(version)s)"

#. module: training_management
#. odoo-python
#: code:addons/training_management/models/training_day.py:0
msgid "%(field)s must reference a survey with survey_role = %(role)s."
msgstr "%(field)s يجب أن يشير إلى استبانة يكون فيها survey_role = %(role)s."

#. module: training_management
#. odoo-python
#: code:addons/training_management/models/training_report.py:0
msgid "%(report)s was approved by %(user)s."
msgstr "%(report)s تمت الموافقة عليه من قبل %(user)s."

#. module: training_management
#. odoo-python
#: code:addons/training_management/models/res_users.py:0
msgid ""
"%(user)s can hold only one operational role (trainee, supervisor or "
"trainer); found: %(roles)s."
msgstr ""
"يمكن للحساب %(user)s أن يحمل دوراً تشغيلياً واحداً فقط (متدربة أو مشرفة أو "
"مدربة)؛ الموجود: %(roles)s."

#. module: training_management
#. odoo-python
#: code:addons/training_management/models/res_users.py:0
msgid ""
"%(user)s's training roles were changed by %(actor)s: added %(added)s, "
"removed %(removed)s."
msgstr ""
"%(actor)s قام بتغيير أدوار %(user)s التدريبية: أُضيف %(added)s، وأُزيل "
"%(removed)s."

#. module: training_management
#. odoo-python
#: code:addons/training_management/models/survey_survey.py:0
