msgstr "%s (إصدار %s)"

#. module: training_management
#. odoo-python
#: code:addons/training_management/models/training_report.py:0
msgid ""
"%s has already been generated; its scope/filters cannot be changed in place."
" Create a new version instead."
msgstr ""
"تم إنشاء %s مسبقاً؛ لا يمكن تغيير نطاقه أو عوامل التصفية فيه مباشرة. أنشئي "
"نسخة جديدة بدلاً من ذلك."

#. module: training_management
#. odoo-python
#: code:addons/training_management/models/training_report.py:0
msgid ""
"%s is an approved report and is immutable. Create a new version instead of "
"editing it."
msgstr "%s تقرير معتمد ولا يمكن تعديله. أنشئي نسخة جديدة بدلاً من التعديل."

#. module: training_management
#. odoo-python
#: code:addons/training_management/models/training_report.py:0
msgid "%s is approved and immutable. Create a new version to regenerate it."
msgstr "%s مُعتمد وغير قابل للتعديل. يرجى إنشاء نسخة جديدة لإعادة إنشائه."

#. module: training_management
#. odoo-python
#: code:addons/training_management/models/training_day.py:0
msgid "%s must be an active user with the Supervisor role."
msgstr "يجب أن يكون %s مستخدماً فعّالاً بدور المشرفة."

#. module: training_management
#. odoo-python
#: code:addons/training_management/models/training_day.py:0
msgid "%s must be an active user with the Trainer role."
msgstr "يجب أن يكون %s مستخدماً فعّالاً بدور المدربة."

#. module: training_management
#: model:mail.template,body_html:training_management.mail_template_daily_task_reminder
msgid ""
"<div style=\"font-family: Arial, sans-serif; font-size: 14px; color: #333333;\">\n"
"    <p>Dear <t t-out=\"object.partner_id.name or ''\">Trainee</t>,</p>\n"
"    <p>\n"
"        You have a pending task for\n"
"        <strong><t t-out=\"object.training_day_id.course_id.name or ''\">Course</t></strong>\n"
"        on <t t-out=\"object.training_day_id.date or ''\">Date</t>.\n"
"    </p>\n"
"    <p>Please complete it in the training portal as soon as possible.</p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"font-family: Arial, sans-serif; font-size: 14px; color: "
"#333333;\">    <p>عزيزي/عزيزتي <t t-out=\"object.partner_id.name or "
"''\">المتدرب</t>،</p>    <p>        لديك مهمة معلقة في        <strong><t "
"t-out=\"object.training_day_id.course_id.name or ''\">الدورة</t></strong>"
"        بتاريخ <t t-out=\"object.training_day_id.date or ''\">التاريخ</t>."
"    </p>    <p>يرجى إتمامها في بوابة التدريب في أقرب وقت ممكن.</p></div>"

