<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_training_day_list" model="ir.ui.view">
        <field name="name">training.day.list</field>
        <field name="model">training.day</field>
        <field name="arch" type="xml">
            <list string="Training Days">
                <field name="date"/>
                <field name="course_id"/>
                <field name="supervisor_id"/>
                <field name="trainer_ids" widget="many2many_tags"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_training_day_form" model="ir.ui.view">
        <field name="name">training.day.form</field>
        <field name="model">training.day</field>
        <field name="arch" type="xml">
            <form string="Training Day">
                <header>
                    <button name="action_open" string="Open" type="object"
                            class="oe_highlight" invisible="state not in ('planned', 'postponed')"/>
                    <button name="action_close" string="Close" type="object"
                            class="oe_highlight" invisible="state != 'open'"/>
                    <button name="action_reopen" string="Reopen" type="object"
                            invisible="state != 'closed'"/>
                    <button name="action_postpone" string="Postpone" type="object"
                            invisible="state not in ('planned', 'open')"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state not in ('planned', 'open', 'postponed')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="planned,open,closed"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <group>
                        <field name="course_id"/>
                        <field name="date"/>
                    </group>
                    <group>
                        <group string="Schedule">
                            <field name="start_datetime"/>
                            <field name="end_datetime"/>
                        </group>
                        <group string="Survey Window">
                            <field name="survey_open_at"/>
                            <field name="survey_close_at"/>
                        </group>
                    </group>
                    <group>
                        <field name="supervisor_id"/>
                        <field name="trainer_ids" widget="many2many_tags"/>
                        <field name="active" invisible="1"/>
                    </group>
                    <group string="Survey Assignment">
                        <field name="trainee_survey_id"/>
                        <field name="supervisor_survey_id"/>
                        <field name="trainer_survey_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_training_day_search" model="ir.ui.view">
        <field name="name">training.day.search</field>
        <field name="model">training.day</field>
        <field name="arch" type="xml">
            <search string="Training Days">
                <field name="course_id"/>
                <field name="supervisor_id"/>
                <field name="trainer_ids"/>
                <filter name="filter_open" string="Open" domain="[('state', '=', 'open')]"/>
                <filter name="filter_closed" string="Closed" domain="[('state', '=', 'closed')]"/>
                <filter name="filter_postponed" string="Postponed" domain="[('state', '=', 'postponed')]"/>
                <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_by_course" string="Course" context="{'group_by': 'course_id'}"/>
                    <filter name="group_by_state" string="State" context="{'group_by': 'state'}"/>
                    <filter name="group_by_supervisor" string="Supervisor" context="{'group_by': 'supervisor_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_training_day_calendar" model="ir.ui.view">
        <field name="name">training.day.calendar</field>
        <field name="model">training.day</field>
        <field name="arch" type="xml">
            <calendar string="Training Days" date_start="start_datetime"
                      date_stop="end_datetime" color="course_id" quick_create="0">
                <field name="course_id"/>
                <field name="supervisor_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="action_training_day" model="ir.actions.act_window">
        <field name="name">Training Days</field>
        <field name="res_model">training.day</field>
        <field name="view_mode">list,form,calendar</field>
        <field name="search_view_id" ref="view_training_day_search"/>
    </record>
</odoo>
