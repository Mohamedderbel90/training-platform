<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- General Supervisor/Admin works primarily in Odoo Web Client
         (PROJECT_SPEC section 2.1). Trainee/Supervisor/Trainer use
         Next.js only, so these backend menus are not shown to them,
         though menu visibility is never relied on as the actual
         security mechanism (ACL/Record Rules in security/ enforce
         that regardless of menu visibility). -->
    <menuitem id="menu_training_management_root"
              name="Training Management"
              groups="group_training_admin"
              sequence="10"/>

    <!-- PROJECT_SPEC section 8 lists "Dashboard / Analytics" as the
         first submenu. General Supervisor (Admin) only (DEC-13: per-response
         scores are General Supervisor only); see
         training_survey_response_kpi.py / ir.model.access.csv. -->
    <menuitem id="menu_training_dashboard"
              name="Dashboard / Analytics"
              parent="menu_training_management_root"
              groups="group_training_admin"
              sequence="5"/>
    <menuitem id="menu_training_dashboard_overview"
              name="Overview"
              parent="menu_training_dashboard"
              action="action_training_dashboard"
              sequence="1"/>
    <menuitem id="menu_training_dashboard_scores"
              name="Score Analysis"
              parent="menu_training_dashboard"
              action="action_training_survey_response_kpi"
              sequence="2"/>

    <menuitem id="menu_training_program"
              name="Programs"
              parent="menu_training_management_root"
              action="action_training_program"
              sequence="10"/>

    <menuitem id="menu_training_course"
              name="Courses"
              parent="menu_training_management_root"
              action="action_training_course"
              sequence="20"/>

    <menuitem id="menu_training_day"
              name="Training Days"
              parent="menu_training_management_root"
              action="action_training_day"
              sequence="30"/>

    <menuitem id="menu_training_day_attendance"
              name="Attendance Records"
              parent="menu_training_day"
              action="action_training_attendance"
              sequence="10"/>

    <!-- Enrollments: the participants list. -->
    <menuitem id="menu_training_enrollment"
              name="Enrollments"
              parent="menu_training_management_root"
              sequence="40"/>
    <menuitem id="menu_training_enrollment_participants"
              name="Participants"
              parent="menu_training_enrollment"
              action="action_training_enrollment"
              sequence="10"/>

    <!-- Standard Odoo Survey UI, filtered to this project's surveys
         (PROJECT_SPEC section 8: "Use Odoo Survey standard UI ... Do
         not build a parallel survey builder"). -->
    <menuitem id="menu_training_survey"
              name="Surveys"
              parent="menu_training_management_root"
              action="action_training_survey"
              sequence="50"/>

    <!-- PROJECT_SPEC section 8 / DEVELOPMENT_PLAN M8: course/program
         reports, versioning, approval, PDF/Excel export. General
         Supervisor only (DEC-15: reports are produced, approved and
         exported by the General Supervisor). -->
    <menuitem id="menu_training_report"
              name="Reports"
              parent="menu_training_management_root"
              action="action_training_report"
              sequence="60"
              groups="group_training_admin"/>

    <!-- PROJECT_SPEC section 8 lists "Notifications" as menu item 8.
         Reminder configuration itself is the Settings page under the
         Settings menu (views/res_config_settings_views.xml); this menu is
         the traceable delivery log (M9 exit criterion). -->
    <menuitem id="menu_training_notification"
              name="Notifications"
              parent="menu_training_management_root"
              action="action_training_notification_log"
              sequence="70"
              groups="group_training_admin"/>

    <!-- PROJECT_SPEC section 8 lists "Audit" as menu item 9 (M10:
         docs/adr/ADR-010-hardening-and-deployment-readiness.md). -->
    <menuitem id="menu_training_audit"
              name="Audit"
              parent="menu_training_management_root"
              action="action_training_audit_log"
              sequence="80"
              groups="group_training_admin"/>

    <!-- Settings (standard module navigation: the last top-level entry
         groups configuration): the native Settings page (reminders and
         channels, FR-072 / DEC-26), General Supervisor only. -->
    <menuitem id="menu_training_settings"
              name="Settings"
              parent="menu_training_management_root"
              sequence="90"
              groups="group_training_admin"/>
    <menuitem id="menu_training_notification_settings"
              name="Settings"
              parent="menu_training_settings"
              action="action_training_settings"
              sequence="10"
              groups="group_training_admin"/>
</odoo>
