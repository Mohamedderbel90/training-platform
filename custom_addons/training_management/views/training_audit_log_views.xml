<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Admin/Assistant Admin, read-only (ir.model.access.csv). PROJECT_SPEC
         section 17: "Audit records are not editable from normal user
         interfaces." -->
    <record id="view_training_audit_log_list" model="ir.ui.view">
        <field name="name">training.audit.log.list</field>
        <field name="model">training.audit.log</field>
        <field name="arch" type="xml">
            <list string="Audit Log" create="false" edit="false" delete="false">
                <field name="create_date" string="Date"/>
                <field name="event_type"/>
                <field name="user_id"/>
                <field name="model_name"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="view_training_audit_log_search" model="ir.ui.view">
        <field name="name">training.audit.log.search</field>
        <field name="model">training.audit.log</field>
        <field name="arch" type="xml">
            <search string="Audit Log">
                <field name="user_id"/>
                <field name="event_type"/>
                <group>
                    <filter name="group_by_event_type" string="Event Type" context="{'group_by': 'event_type'}"/>
                    <filter name="group_by_user" string="Performed By" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_training_audit_log" model="ir.actions.act_window">
        <field name="name">Audit</field>
        <field name="res_model">training.audit.log</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_training_audit_log_search"/>
    </record>
</odoo>
