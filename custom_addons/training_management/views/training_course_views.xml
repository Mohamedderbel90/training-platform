<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_training_course_list" model="ir.ui.view">
        <field name="name">training.course.list</field>
        <field name="model">training.course</field>
        <field name="arch" type="xml">
            <list string="Training Courses">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="program_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
            </list>
        </field>
    </record>

    <record id="view_training_course_form" model="ir.ui.view">
        <field name="name">training.course.form</field>
        <field name="model">training.course</field>
        <field name="arch" type="xml">
            <form string="Training Course">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_days" type="object" class="oe_stat_button" icon="fa-calendar"
                                groups="training_management.group_training_admin">
                            <field name="day_count" widget="statinfo" string="Training Days"/>
                        </button>
                        <button name="action_open_attendance" type="object" class="oe_stat_button" icon="fa-check-square-o"
                                groups="training_management.group_training_admin">
                            <field name="attendance_count" widget="statinfo" string="Attendance"/>
                        </button>
                        <button name="action_open_responses" type="object" class="oe_stat_button" icon="fa-star-o"
                                groups="training_management.group_training_admin">
                            <field name="response_count" widget="statinfo" string="Evaluations"/>
                        </button>
                        <button name="action_open_reports" type="object" class="oe_stat_button" icon="fa-file-text-o"
                                groups="training_management.group_training_admin">
                            <field name="report_count" widget="statinfo" string="Reports"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="alert alert-warning" role="alert"
                         invisible="not dates_outside_program">
                        The course dates are outside the program's dates.
                    </div>
                    <field name="dates_outside_program" invisible="1"/>
                    <group>
                        <field name="name"/>
                        <field name="program_id"/>
                        <field name="sequence"/>
                    </group>
                    <group>
                        <field name="start_date"/>
                        <field name="end_date"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_training_course_search" model="ir.ui.view">
        <field name="name">training.course.search</field>
        <field name="model">training.course</field>
        <field name="arch" type="xml">
            <search string="Training Courses">
                <field name="name"/>
                <field name="program_id"/>
                <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_by_program" string="Program" context="{'group_by': 'program_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_training_course" model="ir.actions.act_window">
        <field name="name">Courses</field>
        <field name="res_model">training.course</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_training_course_search"/>
    </record>
</odoo>
