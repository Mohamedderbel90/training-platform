<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Admin/Assistant Admin only (ir.model.access.csv). System
         -generated audit trail: create/unlink are disabled everywhere in
         the UI (retrying uses action_retry(), never a manual re-create),
         matching "Reminders run automatically and have traceable
         results" (M9 exit criterion). -->
    <record id="view_training_notification_log_list" model="ir.ui.view">
        <field name="name">training.notification.log.list</field>
        <field name="model">training.notification.log</field>
        <field name="arch" type="xml">
            <list string="Notification Log" create="false" delete="false">
                <field name="create_date" string="Date"/>
                <field name="training_day_id"/>
                <field name="respondent_role"/>
                <field name="partner_id"/>
                <field name="channel"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'sent'"
                       decoration-danger="status == 'failed'"
                       decoration-warning="status == 'pending'"/>
                <field name="retry_count"/>
                <field name="sent_date"/>
            </list>
        </field>
    </record>

    <record id="view_training_notification_log_form" model="ir.ui.view">
        <field name="name">training.notification.log.form</field>
        <field name="model">training.notification.log</field>
        <field name="arch" type="xml">
            <form string="Notification Log" create="false" delete="false">
                <header>
                    <button name="action_retry" type="object" string="Retry"
                            class="btn-primary" invisible="status == 'sent'"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="training_day_id" readonly="1"/>
                            <field name="course_id" readonly="1"/>
                            <field name="program_id" readonly="1"/>
                            <field name="respondent_role" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="channel" readonly="1"/>
                            <field name="status" readonly="1"/>
                            <field name="retry_count" readonly="1"/>
                            <field name="sent_date" readonly="1"/>
                            <field name="mail_state" readonly="1"
                                   invisible="channel != 'email'"/>
                            <field name="provider_reference" readonly="1"/>
                        </group>
                    </group>
                    <group string="Error" invisible="status != 'failed'">
                        <field name="error_message" readonly="1" nolabel="1"/>
                    </group>
                    <group string="Message">
                        <field name="body" readonly="1" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_training_notification_log_search" model="ir.ui.view">
        <field name="name">training.notification.log.search</field>
        <field name="model">training.notification.log</field>
        <field name="arch" type="xml">
            <search string="Notification Log">
                <field name="partner_id"/>
                <field name="training_day_id"/>
                <field name="program_id"/>
                <field name="course_id"/>
                <filter name="filter_sent" string="Sent" domain="[('status', '=', 'sent')]"/>
                <filter name="filter_failed" string="Failed" domain="[('status', '=', 'failed')]"/>
                <filter name="filter_pending" string="Pending" domain="[('status', '=', 'pending')]"/>
                <group>
                    <filter name="group_by_channel" string="Channel" context="{'group_by': 'channel'}"/>
                    <filter name="group_by_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_by_role" string="Role" context="{'group_by': 'respondent_role'}"/>
                    <filter name="group_by_day" string="Training Day" context="{'group_by': 'training_day_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_training_notification_log" model="ir.actions.act_window">
        <field name="name">Notifications</field>
        <field name="res_model">training.notification.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_training_notification_log_search"/>
    </record>
</odoo>
