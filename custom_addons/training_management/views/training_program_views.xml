<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_training_program_list" model="ir.ui.view">
        <field name="name">training.program.list</field>
        <field name="model">training.program</field>
        <field name="arch" type="xml">
            <list string="Training Programs">
                <field name="name"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_training_program_form" model="ir.ui.view">
        <field name="name">training.program.form</field>
        <field name="model">training.program</field>
        <field name="arch" type="xml">
            <form string="Training Program">
                <header>
                    <button name="action_activate" string="Activate" type="object"
                            class="btn-primary" invisible="state != 'draft'"
                            groups="training_management.group_training_admin"/>
                    <button name="action_complete" string="Complete" type="object"
                            class="btn-primary" invisible="state != 'active'"
                            groups="training_management.group_training_admin"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state not in ('draft', 'active')"
                            confirm="Cancelling a program is final. Continue?"
                            groups="training_management.group_training_admin"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_courses" type="object" class="oe_stat_button" icon="fa-book"
                                groups="training_management.group_training_admin">
                            <field name="course_count" widget="statinfo" string="Courses"/>
                        </button>
                        <button name="action_open_days" type="object" class="oe_stat_button" icon="fa-calendar"
                                groups="training_management.group_training_admin">
                            <field name="day_count" widget="statinfo" string="Training Days"/>
                        </button>
                        <button name="action_open_enrollments" type="object" class="oe_stat_button" icon="fa-users"
                                groups="training_management.group_training_admin">
                            <field name="enrollment_count" widget="statinfo" string="Participants"/>
                        </button>
                        <button name="action_open_attendance" type="object" class="oe_stat_button" icon="fa-check-square-o"
                                groups="training_management.group_training_admin">
                            <field name="attendance_count" widget="statinfo" string="Attendance"/>
                        </button>
                        <button name="action_open_responses" type="object" class="oe_stat_button" icon="fa-star-o"
                                groups="training_management.group_training_admin">
                            <field name="response_count" widget="statinfo" string="Evaluations"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <group>
                        <field name="name"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,active,completed"/>
                    </group>
                    <group>
                        <field name="start_date"/>
                        <field name="end_date"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_training_program_search" model="ir.ui.view">
        <field name="name">training.program.search</field>
        <field name="model">training.program</field>
        <field name="arch" type="xml">
            <search string="Training Programs">
                <field name="name"/>
                <filter name="filter_active" string="Active" domain="[('state', '=', 'active')]"/>
                <filter name="filter_completed" string="Completed" domain="[('state', '=', 'completed')]"/>
                <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_by_state" string="State" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_training_program" model="ir.actions.act_window">
        <field name="name">Programs</field>
        <field name="res_model">training.program</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_training_program_search"/>
    </record>
</odoo>
